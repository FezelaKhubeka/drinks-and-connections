/* GPS NEARBY SEARCH */

.gps-panel {
  text-align: center;
}

.gps-button {
  width: 100%;
  margin: 10px 0;
  background: var(--gold);
}

.gps-controls {
  margin: 15px 0;
  text-align: left;
}

.radar {
  width: 180px;
  height: 180px;
  border: 2px solid var(--gold);
  border-radius: 50%;
  margin: 25px auto;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle, transparent 20%, #d9ad6220 21%, transparent 22%),
    radial-gradient(circle, transparent 45%, #d9ad6240 46%, transparent 47%),
    #111117;
}

.radar::before {
  content: "";
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 50%;
  transform-origin: top left;
  background: linear-gradient(45deg, #d9ad6280, transparent);
  animation: radarScan 2s linear infinite;
}

.radar::after {
  content: "";
  position: absolute;
  width: 10px;
  height: 10px;
  background: var(--gold);
  border-radius: 50%;
  left: calc(50% - 5px);
  top: calc(50% - 5px);
  box-shadow: 0 0 15px var(--gold);
}

@keyframes radarScan {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.gps-status {
  color: var(--gold);
  text-align: center;
  min-height: 25px;
}

.nearby-distance {
  color: var(--success) !important;
  font-weight: bold;
}